{
  "name": "ajia-epub-editor",
  "version": "0.1.1",
  "description": "Local-first, preserve-first browser editor for safe text corrections in EPUB 2 and EPUB 3 books",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AjiaijA/ajia-epub-editor.git"
  },
  "homepage": "https://ajia.site/tools/epub-editor/",
  "keywords": [
    "epub",
    "epub-editor",
    "local-first",
    "preserve-first",
    "xhtml"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:core": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture:export": "tsx scripts/exportFixture.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:package": "tsx scripts/packageRelease.ts",
    "release:rc": "npm run check && npm run test:coverage && npm run test:e2e && npm run release:package",
    "spike:text": "vitest run tests/unit/safeTextPatch.test.ts",
    "spike:zip": "vitest run tests/unit/epubZip.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run fixture:export && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-xml": "^6.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
