{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "eslint.config.js",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
